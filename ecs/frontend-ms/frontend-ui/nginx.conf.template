server {
    listen 3000;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Debug logging
    error_log /dev/stdout debug;
    access_log /dev/stdout combined;

    # Static content location
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Users API endpoint
    location /api/users {
        proxy_http_version 1.1;
        proxy_set_header Host ${USERS_DOMAIN};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;

        # SSL settings
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_ssl_verify off;

        proxy_redirect off;

        # Error handling
        proxy_intercept_errors on;
        error_page 404 = @handle_404;

        proxy_pass http://${USERS_DOMAIN}/api/users;
    }

    # Products API endpoint
    location /api/products {
        proxy_http_version 1.1;
        proxy_set_header Host ${PRODUCTS_DOMAIN};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;

        # SSL settings
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_ssl_verify off;

        proxy_redirect off;

        # Error handling
        proxy_intercept_errors on;
        error_page 404 = @handle_404;

        proxy_pass http://${PRODUCTS_DOMAIN}/api/products;
    }

    # Orders API endpoint
    location /api/orders {
        proxy_http_version 1.1;
        proxy_set_header Host ${ORDERS_DOMAIN};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;

        # SSL settings
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_ssl_verify off;

        proxy_redirect off;

        # Error handling
        proxy_intercept_errors on;
        error_page 404 = @handle_404;

        proxy_pass http://${ORDERS_DOMAIN}/api/orders;
    }

    # Custom 404 handler
    location @handle_404 {
        default_type application/json;
        return 404 '{"error": "Not Found", "message": "The requested resource was not found"}';
    }

}
